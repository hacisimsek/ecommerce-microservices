# Copy to .env before `docker compose up`:  cp .env.example .env
# Values below are for LOCAL DEVELOPMENT ONLY. Use real secrets (and a secret manager) elsewhere.

# ---- Host ports (chosen to avoid clashing with other local stacks on 8080/5432/6379/9092)
GATEWAY_PORT=8088
EUREKA_PORT=8761
POSTGRES_PORT=5433
MONGO_PORT=27017
REDIS_PORT=6380
KAFKA_PORT=29092
KAFKA_UI_PORT=8089

# ---- Postgres: superuser (init only) and one role per service database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
ORDER_DB_PASSWORD=change-me-order
PAYMENT_DB_PASSWORD=change-me-payment
SHIPPING_DB_PASSWORD=change-me-shipping

# ---- MongoDB root user (inventory, notification)
MONGO_USERNAME=ecommerce
MONGO_PASSWORD=change-me-mongo

# ---- Redis
REDIS_PASSWORD=change-me-redis

# ---- Fake payment provider: decline probability and hard amount limit
PAYMENT_FAILURE_RATE=0.0
PAYMENT_MAX_AMOUNT=10000

# ---- Fake carrier: orders worth more than this cannot be shipped (triggers refund + stock release)
SHIPPING_MAX_INSURED_VALUE=5000
