# Copy to .env to override defaults. Host ports are chosen to avoid clashing with
# other local stacks that commonly use 8080/5432/6379/9092.
GATEWAY_PORT=8088
EUREKA_PORT=8761
POSTGRES_PORT=5433
MONGO_PORT=27017
REDIS_PORT=6380
KAFKA_PORT=29092
KAFKA_UI_PORT=8089

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Fake payment provider: decline probability and hard amount limit
PAYMENT_FAILURE_RATE=0.0
PAYMENT_MAX_AMOUNT=10000
